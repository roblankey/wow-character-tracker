# Battle.net developer application credentials — https://develop.battle.net
BATTLENET_CLIENT_ID=
BATTLENET_CLIENT_SECRET=
# Must exactly match the redirect URI configured on the Battle.net app
BATTLENET_REDIRECT_URI=http://localhost:3001/api/connection/callback
# Region the connected Battle.net account belongs to: us, eu, kr, or tw
BATTLENET_REGION=us

# Where to store the local SQLite database
DB_PATH=./data/wow-character-tracker.sqlite

# 64-character hex string (32 bytes) used to encrypt OAuth tokens at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

PORT=3001

# Where the browser should land after the Battle.net OAuth callback.
# Blizzard redirects the browser directly to the backend, not through the
# frontend dev proxy, so this must be an absolute URL. Defaults to the
# frontend dev server if unset.
FRONTEND_URL=http://localhost:5173
